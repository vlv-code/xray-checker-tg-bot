# ==============================================================================
# Xray Checker with Telegram Bot Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Subscriptions
# ------------------------------------------------------------------------------
# URL(s) of the proxy subscription(s). Can be a single URL or comma-separated list.
# Supports HTTP/HTTPS URLs (Base64 or JSON), share links (vless://, vmess://, etc.)
SUBSCRIPTION_URL=https://example.com/api/v1/client/subscribe?token=YOUR_TOKEN_HERE

# Whether to periodically update subscriptions (default: true)
SUBSCRIPTION_UPDATE=true

# Interval in seconds between subscription updates (default: 300)
SUBSCRIPTION_UPDATE_INTERVAL=300

# Request full JSON configs from panel (for Remnawave and subscriptions with balancers)
SUBSCRIPTION_JSON_FORMAT=false

# Custom User-Agent for subscription requests (optional)
# SUBSCRIPTION_USER_AGENT=ClashMeta

# Extra HTTP headers in 'Key: Value' form (comma-separated if multiple)
# SUBSCRIPTION_HEADERS=X-Custom-Header: value

# Path to JSON file where subscriptions added via Telegram bot's /addsub are persisted.
# Inside Docker, keep this pointing to the mounted volume directory (/app/data/subscriptions.json).
SUBSCRIPTION_STORE_PATH=/app/data/subscriptions.json

# ------------------------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------------------------
# Bot token from @BotFather. Setting this token activates the Telegram bot.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Chat ID(s) allowed to receive alerts and execute interactive commands (/status, /subs, /addsub, /delsub).
# Multiple chat IDs can be separated by commas (e.g. personal ID and group ID).
TELEGRAM_CHAT_IDS=123456789,-100987654321

# Send a notification when a proxy recovers and comes back online (default: true)
TELEGRAM_NOTIFY_ON_RECOVERY=true

# Enable interactive bot commands (/status, /help, /start) (default: true)
TELEGRAM_COMMANDS_ENABLED=true

# Allow managing subscriptions via /addsub, /delsub, /subs from chat (default: true)
TELEGRAM_MANAGE_SUBSCRIPTIONS=true

# Alert notification mode: 'live' (edits outage alert with downtime) or 'clean' (auto-deletes on recovery)
TELEGRAM_ALERT_MODE=live

# Quiet hours (do not send individual alert pings at night, buffer for morning digest)
TELEGRAM_QUIET_HOURS_ENABLED=true
TELEGRAM_QUIET_HOURS_START=23:00
TELEGRAM_QUIET_HOURS_END=08:00

# Periodic daytime digests (in hours, e.g. 6)
TELEGRAM_DAY_DIGEST_ENABLED=true
TELEGRAM_DAY_DIGEST_INTERVAL_HOURS=6

# Persistent storage paths for outage stats and bot config overrides
STATS_STORE_PATH=/app/data/stats.json
BOT_CONFIG_STORE_PATH=/app/data/bot_config.json

# Custom target check URLs (fallback targets for checking proxy availability)
PROXY_TARGET_URLS=https://cp.cloudflare.com/generate_204,https://www.gstatic.com/generate_204

# ------------------------------------------------------------------------------
# Proxy Checks
# ------------------------------------------------------------------------------
# Interval between proxy check cycles in seconds (default: 300)
PROXY_CHECK_INTERVAL=300

# Maximum number of proxies checked concurrently per cycle (0 = unlimited, default: 0)
PROXY_CHECK_CONCURRENCY=0

# Checking method: 'ip' (requests IP service), 'status' (HTTP 204), or 'download' (tests file download)
PROXY_CHECK_METHOD=ip

# URL for IP check method (default: https://api.ipify.org?format=text)
PROXY_IP_CHECK_URL=https://api.ipify.org?format=text

# URL for status check method (default: http://cp.cloudflare.com/generate_204)
PROXY_STATUS_CHECK_URL=http://cp.cloudflare.com/generate_204

# Timeout for individual proxy check in seconds (default: 30)
PROXY_TIMEOUT=30

# Resolve proxy server domains into individual IPs (default: false)
PROXY_RESOLVE_DOMAINS=false

# Starting port for local Xray SOCKS inbounds (default: 10000)
XRAY_START_PORT=10000

# Xray Core log level (debug|info|warning|error|none, default: none)
XRAY_LOG_LEVEL=none

# ------------------------------------------------------------------------------
# Web Dashboard & Metrics
# ------------------------------------------------------------------------------
# Enable web dashboard panel (default: true). Set to false to run headless/without web UI.
WEB_ENABLED=true

# Host and port for Web UI & Prometheus metrics (set METRICS_PORT=0 to disable HTTP server)
METRICS_HOST=0.0.0.0
METRICS_PORT=2112

# Enable HTTP Basic Authentication for dashboard & metrics (recommended: true)
METRICS_PROTECTED=true
METRICS_USERNAME=admin
METRICS_PASSWORD=ChangeThisPassword123!

# Instance label added to Prometheus metrics (optional)
# METRICS_INSTANCE=production-checker

# Show server IP addresses and ports in Web UI (default: false)
WEB_SHOW_DETAILS=false

# ------------------------------------------------------------------------------
# General Settings
# ------------------------------------------------------------------------------
# Application log level (debug|info|warn|error|none, default: info)
LOG_LEVEL=info

# Run one check cycle and exit (for cron/scheduled jobs, default: false)
RUN_ONCE=false
