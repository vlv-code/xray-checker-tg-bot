# ==============================================================================
# Xray Checker with Telegram Bot Configuration (.env)
#
# Every variable below is optional unless marked REQUIRED. Defaults shown in
# comments are the code defaults applied when the variable is unset. Paths are
# pinned to /app/data (the bind-mounted volume) so that state — dynamic
# subscriptions, stats, bot settings, active alerts — survives container
# rebuilds; keep those overrides if you deploy via Docker Compose.
# ==============================================================================

# ------------------------------------------------------------------------------
# Subscriptions
# ------------------------------------------------------------------------------
# REQUIRED. Where to fetch the proxy list from. Accepts:
#   - http(s):// URLs returning Base64 share-link lists or JSON configs
#     (comma-separated for multiple subscriptions)
#   - file:///path/to/sub.txt          — a local file with share links
#   - folder:///path/to/configs/       — a directory of xray JSON config files
#   - base64://<data>                  — inline base64 payload
#   - raw share links pasted directly  — vless://, vmess://, trojan://, ss://,
#                                        hysteria2://, socks://, wg:// ...
# When multiple sources are given, proxies from all of them are merged.
#
# SSRF protection: http(s) subscription URLs pointing to localhost, private,
# link-local, CGNAT, IPv6 transition (NAT64/6to4/Teredo) or other reserved
# ranges — including hostnames that resolve to such addresses — are rejected;
# there is no opt-out switch. A panel hosted on your LAN therefore cannot be
# fetched directly: expose it on a public address, or sync its subscription
# output to a local file and use file:// instead.
SUBSCRIPTION_URL=https://example.com/api/v1/client/subscribe?token=YOUR_TOKEN_HERE

# Re-fetch every subscription periodically and apply changes automatically:
# new proxies are added, removed ones dropped, Xray restarts with the updated
# config. A failed fetch keeps the previous proxy set (no outage on panel
# hiccups). (default: true)
SUBSCRIPTION_UPDATE=true

# How often to re-fetch subscriptions, in seconds (default: 300)
SUBSCRIPTION_UPDATE_INTERVAL=300

# Ask the panel for full JSON configs instead of collapsed share-link lists.
# Enable for Remnawave-style panels and subscriptions with balancer/group nodes:
# the app-like User-Agent below makes the panel return grouped/balancer nodes
# individually. (default: false)
SUBSCRIPTION_JSON_FORMAT=false

# Override the User-Agent sent with subscription requests. Panels gate their
# response format by client type (Clash, v2rayNG, Happ...), so this can change
# what the panel returns. Takes precedence over SUBSCRIPTION_JSON_FORMAT.
# SUBSCRIPTION_USER_AGENT=ClashMeta

# Extra HTTP headers for subscription requests, 'Key: Value' pairs separated
# by commas — for panels that require custom auth or routing headers.
# SUBSCRIPTION_HEADERS=X-Custom-Header: value

# JSON file where subscriptions added at runtime via the Telegram bot's
# /addsub are persisted, so they survive restarts. They are merged with
# SUBSCRIPTION_URL on every load. (default: subscriptions.json)
SUBSCRIPTION_STORE_PATH=/app/data/subscriptions.json

# JSON file where fetched proxy configurations are cached, allowing the checker
# to start with cached proxies even if the subscription upstream or panel is
# temporarily unreachable on startup. (default: proxy_cache.json)
SUBSCRIPTION_CACHE_PATH=/app/data/proxy_cache.json

# ------------------------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------------------------
# Bot token from @BotFather. Setting this activates the bot (long polling,
# alerts, interactive menus). Leave empty to run the checker without Telegram.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# REQUIRED when the bot token is set. Comma-separated delivery targets for
# alerts, digests and interactive commands. Each entry is an independent
# destination:
#   123456789          — a private chat or a whole group (General topic in
#                        forum supergroups)
#   -100987654321      — a plain group / supergroup
#   -100987654321:42   — topic 42 of a forum supergroup only
# Run /id inside any chat or topic — the bot replies with a ready-to-paste
# entry. Every target gets its own copy of each alert; commands always answer
# in the chat/topic they were issued in.
TELEGRAM_CHAT_IDS=123456789,-100987654321,-100987654321:42

# Also send a notification when a proxy comes back online (default: true).
# In 'clean' alert mode the recovery note is auto-deleted after 2 minutes;
# set false for outage-only notifications.
TELEGRAM_NOTIFY_ON_RECOVERY=true

# Enable interactive commands (/menu, /status, /diag, /stats, ...) and the
# inline menu. Turn off for a notification-only bot. (default: true)
TELEGRAM_COMMANDS_ENABLED=true

# Allow allowed chats to manage subscription URLs via /addsub, /delsub and
# /subs. Only people in TELEGRAM_CHAT_IDS can do this either way.
# (default: true)
TELEGRAM_MANAGE_SUBSCRIPTIONS=true

# Optional comma-separated Telegram user IDs with administrative privileges.
# If set, mutating commands (/interval, /addsub, /delsub, /nodeadd, /nodedel,
# /nodesubs, /nodeaddsub, /nodedelsub, /togglehost, /quiet, /checkupdate)
# are restricted strictly to these users, even in group chats in TELEGRAM_CHAT_IDS.
# (default: empty — any participant in TELEGRAM_CHAT_IDS can execute commands)
# TELEGRAM_ADMIN_USER_IDS=123456789,987654321

# Periodic checks and alerts for new GitHub releases of Xray Checker (default: true).
TELEGRAM_RELEASE_ALERTS=true

# How often to check GitHub releases, in hours (default: 6).
TELEGRAM_RELEASE_CHECK_INTERVAL_HOURS=6

# Periodic background audit of every subscription host through Check-Host.net
# probes: detects hosts blocked or unreachable from Russia even while they
# look fine from the checker's own network. (default: true)
CHECKHOST_BG_ENABLED=true

# Interval in hours between background Check-Host audits (default: 1).
# Audit requests are rate-limited between hosts to stay polite to the API.
CHECKHOST_INTERVAL_HOURS=1

# Send a Telegram alert when a host is unreachable from the Russian
# Check-Host nodes ("вероятная блокировка РКН") while reachable from abroad.
# (default: true)
CHECKHOST_ALERT_ENABLED=true

# Alert notification mode:
#   clean — outage alert is deleted from the chat upon recovery (default)
#   live  — outage message is edited in place to show recovery + downtime
# Changeable at runtime via the bot menu (⚙️ Настройки → 🧹 Режим алертов).
TELEGRAM_ALERT_MODE=clean

# Render /diag reports as Telegram Bot API 10.1 rich messages (table +
# collapsible failure details) instead of paginated text pages.
# (default: false)
TELEGRAM_RICH_MODE=false

# Quiet hours: individual alert messages are held overnight and summarized in
# a morning digest instead of pinging at night. Changeable at runtime.
TELEGRAM_QUIET_HOURS_ENABLED=true

# Quiet hours window, local time HH:MM. Recovery notifications during quiet
# hours are silent too. A snooze (bot menu or /quiet) pauses alerts without
# touching the schedule.
TELEGRAM_QUIET_HOURS_START=23:00
TELEGRAM_QUIET_HOURS_END=08:00

# Periodic daytime health summaries every N hours (default: 6; 0 disables).
TELEGRAM_DAY_DIGEST_ENABLED=true
TELEGRAM_DAY_DIGEST_INTERVAL_HOURS=6

# Persistent storage for outage statistics (uptime %, incident log, latency
# percentiles, MTBF/MTTR) shown in /stats. Flushed to disk periodically and
# on shutdown. (default: stats.json)
STATS_STORE_PATH=/app/data/stats.json

# Persistent storage for settings changed via the bot menu at runtime: check
# interval, quiet hours, alert mode, timezone, disabled nodes/hosts, rich
# mode. Overrides the env defaults until changed back. (default: bot_config.json)
BOT_CONFIG_STORE_PATH=/app/data/bot_config.json

# Persistent storage for currently active outage alerts — the anti-flapping
# state that lets the bot edit/delete the right message after a restart.
# The code default (alerts.json, working directory) lands OUTSIDE the
# /app/data volume in Docker and is lost on rebuild — keep this override.
ALERT_STORE_PATH=/app/data/alerts.json

# Fallback target URLs for checking proxy availability (and the endpoints
# probed by /diag). Only used when no custom targets are configured via the
# bot's /targets menu. Full URLs returning quickly with any 2xx/3xx.
PROXY_TARGET_URLS=https://cp.cloudflare.com/generate_204,https://www.gstatic.com/generate_204

# ------------------------------------------------------------------------------
# Outbound Network Proxy (Optional)
# ------------------------------------------------------------------------------
# Upstream proxy for the checker's own outbound connections (Telegram API,
# Check-Host, subscription fetching). Essential on servers where Telegram is
# blocked (e.g. Russian VPS). Standard Go net/http variables; supports SOCKS5
# (socks5://host:port) and HTTP (http://host:port). In Docker Compose paired
# with an Xray/Sing-box client container use its service name as the host:
# HTTP_PROXY=socks5://xray-client:1080
# HTTPS_PROXY=socks5://xray-client:1080
# ALL_PROXY=socks5://xray-client:1080
# NO_PROXY=localhost,127.0.0.1
#
# Dedicated corporate/bootstrap proxy used ONLY for downloading subscriptions
# and Geo databases (geoip.dat/geosite.dat) from GitHub on restricted hosts.
# Does NOT affect communication with master or direct proxy checks:
# BOOTSTRAP_PROXY=http://192.168.27.121:10809

# ------------------------------------------------------------------------------
# Proxy Checks
# ------------------------------------------------------------------------------
# Pause between check cycles in seconds (default: 300; minimum 10). A cycle
# that overruns the interval degrades to running less often rather than
# piling up. Also changeable at runtime via /interval or the bot menu — the
# runtime value is persisted in the bot config store.
PROXY_CHECK_INTERVAL=300

# Maximum proxies checked in parallel per cycle (default: 0 = unlimited).
# With a large subscription, set this to bound the burst of outbound
# connections (each proxy dial is still capped by PROXY_TIMEOUT); it also
# throttles the /diag fan-out. If a cycle regularly takes longer than
# PROXY_CHECK_INTERVAL, the log will suggest raising this or the interval.
PROXY_CHECK_CONCURRENCY=0

# How "online" is decided:
#   ip      — fetch PROXY_IP_CHECK_URL through the proxy and compare the
#             returned IP with the checker's own (catches transparent-proxy
#             leaks); the IP is re-learned hourly
#   status  — fetch PROXY_STATUS_CHECK_URL through the proxy, any 2xx/3xx
#             counts as online (fastest, no external IP service involved)
#   download— fetch PROXY_DOWNLOAD_URL through the proxy and verify at least
#             PROXY_DOWNLOAD_MIN_SIZE bytes arrive within PROXY_DOWNLOAD_TIMEOUT
PROXY_CHECK_METHOD=ip

# URL of the IP echo service for check-method=ip (must return a bare IP).
PROXY_IP_CHECK_URL=https://api.ipify.org?format=text

# URL for check-method=status (should respond quickly with 2xx/3xx).
PROXY_STATUS_CHECK_URL=http://cp.cloudflare.com/generate_204

# File to download for check-method=download. Pick a size your nodes can
# pull within the timeout — a 1Mb file is a reasonable middle ground.
PROXY_DOWNLOAD_URL=https://proof.ovh.net/files/1Mb.dat

# Timeout for the download check in seconds (default: 60)
PROXY_DOWNLOAD_TIMEOUT=60

# Minimum bytes that must arrive for the download check to count as
# successful (default: 51200 = 50 KB)
PROXY_DOWNLOAD_MIN_SIZE=51200

# Timeout for a single proxy check in seconds — this is the per-connection
# cap for the whole cycle (default: 30)
PROXY_TIMEOUT=30

# Pre-resolve proxy server domains into individual IP proxies at config
# load/update time. Enable only if your panel gives per-IP nodes; increases
# the proxy count accordingly. (default: false)
PROXY_RESOLVE_DOMAINS=false

# Add the measured proxy latency as an artificial delay to /config/{id}
# badge responses, so status badges in external tools show realistic
# response times. Capped at 2 seconds regardless of measured latency.
# (default: true)
SIMULATE_LATENCY=true

# ------------------------------------------------------------------------------
# Xray Core
# ------------------------------------------------------------------------------
# Each subscription proxy gets its own local SOCKS5 inbound on
# XRAY_START_PORT + <proxy index>. Checks and diagnostics connect through
# these ports. (default: 10000)
XRAY_START_PORT=10000

# Xray core's own log level (debug|info|warning|error|none, default: none).
# Core lines are only surfaced when the app's LOG_LEVEL is debug; raise this
# only when debugging protocol-level failures.
XRAY_LOG_LEVEL=none

# ------------------------------------------------------------------------------
# Web Dashboard & Metrics
# ------------------------------------------------------------------------------
# Enable the web dashboard (status page, /config/{id} pages, public API).
# With false the HTTP server serves only /metrics (and /health) — headless
# mode. (default: true)
WEB_ENABLED=true

# Bind address and port for the web dashboard and Prometheus metrics.
# Bare metal: set METRICS_PORT=0 to disable the HTTP server entirely
# (Telegram bot / scheduler only).
# Docker Compose: do NOT set 0 here — it breaks the ports mapping ("0:0");
# for a headless container set WEB_ENABLED=false and comment out the ports
# section in docker-compose.yml instead.
METRICS_HOST=0.0.0.0
METRICS_PORT=2112

# Require HTTP Basic Auth for everything the server exposes: dashboard,
# /metrics, /config/{id} pages, static assets and all /api/ routes (only
# /health stays open for load-balancer probes). When true,
# METRICS_PASSWORD becomes REQUIRED. (default: false — recommended: true)
METRICS_PROTECTED=true
METRICS_USERNAME=admin
METRICS_PASSWORD=ChangeThisPassword123!

# Public status page mode (requires METRICS_PROTECTED=true). Opens the
# dashboard, /config/{id} pages and GET /api/v1/public/proxies to anonymous
# visitors — proxy names, groups, online status and latency become public —
# while /metrics and the management API stay behind Basic Auth. Only enable
# this if you accept publishing that information. (default: false)
# WEB_PUBLIC=false

# In public mode, additionally hide the protocol badge on status cards
# (default: false; the badge is always shown in non-public mode).
# WEB_PUBLIC_SHOW_PROTOCOL=false

# Set true only when the whole dashboard sits behind an external auth proxy
# (Authelia, oauth2-proxy...): allows showing server details on the public
# page on the assumption that access is already gated. (default: false)
# WEB_TRUSTED_EXTERNAL_AUTH=false

# URL base path prefix for the dashboard and metrics, for deployments behind
# a reverse proxy that routes a subpath, e.g. /xray → the checker.
# (default: empty — served from root)
# METRICS_BASE_PATH=/xray

# Push metrics to a Prometheus Pushgateway on every check cycle instead of
# exposing /metrics for scraping. Credentials embedded in the URL are
# supported (username, or username:password).
# METRICS_PUSH_URL=https://pushgateway.example.com

# Value of the "instance" label on exported metrics — useful to tell apart
# several checker instances in one Grafana. (default: "")
# METRICS_INSTANCE=production-checker

# Show proxy server IPs and ports in the web UI. The public status page and
# the JSON API mask these regardless. (default: false)
WEB_SHOW_DETAILS=false

# Directory with custom web assets overriding the embedded ones: logo.svg,
# favicon.ico, custom.css, index.html. Inside Docker point it at the
# mounted volume, e.g. /app/data/assets. (default: "" — embedded assets)
# WEB_CUSTOM_ASSETS_PATH=/app/data/assets

# ------------------------------------------------------------------------------
# General Settings
# ------------------------------------------------------------------------------
# Application log level (debug|info|warn|error|none, default: info).
# debug also dumps parsed proxy configs — passwords/UUIDs are masked.
LOG_LEVEL=info

# Run a single check cycle and exit — for cron/scheduled jobs. The Telegram
# bot is not started in this mode. (default: false)
RUN_ONCE=false

# ------------------------------------------------------------------------------
# Remote checker nodes (master side)
# ------------------------------------------------------------------------------
# Remote checker instances that push check reports to this master, as
# 'name|token' entries (comma-separated or repeat --node). The token is the
# bearer token the node authenticates with. Empty disables the feature.
# Requires a listening METRICS_PORT for the ingest endpoint
# POST /api/v1/nodes/report. (default: empty)
# NODES=node-1|changeMeLongToken1,node-2|changeMeLongToken2

# File storing the desired managed subscriptions per node, edited via the
# bot's /nodeaddsub and /nodedelsub. Note: dynamically registered nodes via
# /nodeadd are automatically saved alongside this file in nodes.json.
# (default: node_subs.json; recommended in Docker: /app/data/node_subs.json)
# NODES_STORE_PATH=/app/data/node_subs.json

# Public URL of the master report endpoint, displayed in the bot's /nodeadd
# instructions and docker run snippets. If unset, automatically defaults to
# http://<DETECTED_IP>:METRICS_PORT/api/v1/nodes/report.
# MASTER_PUBLIC_URL=http://your-master-ip:2112/api/v1/nodes/report

# Maximum timeout in seconds before a silent remote node is marked stale/offline.
# When 0 (default), dynamically calculated as 2 * node_interval + 30s.
# MASTER_STALE_TIMEOUT_SEC=0

# ------------------------------------------------------------------------------
# Remote checker nodes (node side)
# ------------------------------------------------------------------------------
# Master ingest URL this instance pushes its check snapshots to, e.g.
# https://master.example:2112/api/v1/nodes/report. Set it together with
# REPORT_TOKEN and without TELEGRAM_BOT_TOKEN to run as a headless node —
# no inbound ports required. Empty disables reporting. (default: empty)
# REPORT_URL=https://master.example:2112/api/v1/nodes/report

# Bearer token matching this node's entry in the master's NODES list.
# (default: empty — must be set when REPORT_URL is set)
# REPORT_TOKEN=changeMeLongToken1

# ------------------------------------------------------------------------------
# Node ASN lookup (master side)
# ------------------------------------------------------------------------------
# Gzipped ASN mmdb database (db-ip asn-lite format) used to annotate node
# alerts with the node's network operator. Downloaded once at startup;
# failures degrade to an empty ASN and never affect alerting. The default
# URL embeds a release month — override after db-ip publishes a newer one.
# (default: db-ip asn-lite 2026-08)
# ASN_DB_URL=https://download.db-ip.com/free/dbip-asn-lite-2026-08.mmdb.gz
