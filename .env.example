# ==============================================================================
# Xray Checker with Telegram Bot Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Subscriptions
# ------------------------------------------------------------------------------
# URL(s) of the proxy subscription(s). Can be a single URL or comma-separated list.
# Supports HTTP/HTTPS URLs (Base64 or JSON), share links (vless://, vmess://, etc.)
# and local sources: file:///path/to/sub.txt, folder:///path/to/configs/,
# base64://<data>, or raw share links pasted directly.
#
# SSRF protection: http(s) subscription URLs pointing to localhost, private,
# link-local, CGNAT or other reserved ranges (including hostnames that resolve
# to such addresses) are rejected — there is no opt-out switch. A panel hosted
# on your LAN therefore cannot be fetched directly; expose it on a public
# address, or sync its subscription to a local file and use file:// instead.
SUBSCRIPTION_URL=https://example.com/api/v1/client/subscribe?token=YOUR_TOKEN_HERE

# Whether to periodically update subscriptions (default: true)
SUBSCRIPTION_UPDATE=true

# Interval in seconds between subscription updates (default: 300)
SUBSCRIPTION_UPDATE_INTERVAL=300

# Request full JSON configs from panel (for Remnawave and subscriptions with balancers)
SUBSCRIPTION_JSON_FORMAT=false

# Custom User-Agent for subscription requests (optional)
# SUBSCRIPTION_USER_AGENT=ClashMeta

# Extra HTTP headers in 'Key: Value' form (comma-separated if multiple)
# SUBSCRIPTION_HEADERS=X-Custom-Header: value

# Path to JSON file where subscriptions added via Telegram bot's /addsub are persisted.
# Inside Docker, keep this pointing to the mounted volume directory (/app/data/subscriptions.json).
SUBSCRIPTION_STORE_PATH=/app/data/subscriptions.json

# ------------------------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------------------------
# Bot token from @BotFather. Setting this token activates the Telegram bot.
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Delivery targets for alerts, digests and interactive commands (/status, /subs, /addsub, /delsub).
# Forms: "<chat_id>" for a private chat or a whole group (General topic in forum
# groups), and "<chat_id>:<topic_id>" for one forum topic of a supergroup
# (e.g. -100987654321:42). Multiple targets are separated by commas.
# Run /id inside a chat or topic to copy its ready-made entry.
TELEGRAM_CHAT_IDS=123456789,-100987654321,-100987654321:42

# Send a notification when a proxy recovers and comes back online (default: true)
TELEGRAM_NOTIFY_ON_RECOVERY=true

# Enable interactive bot commands (/status, /help, /start) (default: true)
TELEGRAM_COMMANDS_ENABLED=true

# Allow managing subscriptions via /addsub, /delsub, /subs from chat (default: true)
TELEGRAM_MANAGE_SUBSCRIPTIONS=true

# Periodic background Check-Host.net audit of all subscription hosts
# (default: true)
CHECKHOST_BG_ENABLED=true

# Interval in hours between background Check-Host audits (default: 1)
CHECKHOST_INTERVAL_HOURS=1

# Send a Telegram alert when a host is unreachable from Russian
# Check-Host nodes (default: true)
CHECKHOST_ALERT_ENABLED=true

# Alert notification mode: 'clean' (default: auto-deletes alert upon recovery) or 'live' (in-place edit with downtime duration)
TELEGRAM_ALERT_MODE=clean

# Diagnostic display mode: false (default: in-place pagination + [📊 Открыть Rich-отчёт]) or true (Telegram Bot API 10.1 rich messages)
TELEGRAM_RICH_MODE=false

# Quiet hours (do not send individual alert pings at night, buffer for morning digest)
TELEGRAM_QUIET_HOURS_ENABLED=true
TELEGRAM_QUIET_HOURS_START=23:00
TELEGRAM_QUIET_HOURS_END=08:00

# Periodic daytime digests (in hours, e.g. 6)
TELEGRAM_DAY_DIGEST_ENABLED=true
TELEGRAM_DAY_DIGEST_INTERVAL_HOURS=6

# Persistent storage paths for outage stats, bot config overrides, and active alerts
STATS_STORE_PATH=/app/data/stats.json
BOT_CONFIG_STORE_PATH=/app/data/bot_config.json
# Active outage alerts (anti-flapping state that must survive container rebuilds).
# The code default is a relative "alerts.json" (working directory), which inside the
# Docker container lands OUTSIDE the /app/data volume and is lost on rebuild —
# keep this pointed at the mounted volume.
ALERT_STORE_PATH=/app/data/alerts.json

# Custom target check URLs (fallback targets for checking proxy availability)
PROXY_TARGET_URLS=https://cp.cloudflare.com/generate_204,https://www.gstatic.com/generate_204

# ------------------------------------------------------------------------------
# Outbound Network Proxy (Optional)
# ------------------------------------------------------------------------------
# Upstream proxy for outbound bot connections (Telegram API, Check-Host, subscriptions).
# Essential when running on servers where Telegram API is blocked (e.g. Russian VPS).
# Standard Go net/http variables; supports SOCKS5 (socks5://host:port) and HTTP (http://host:port).
# In Docker Compose paired with an Xray/Sing-box client container, use: socks5://xray-client:1080
# HTTP_PROXY=socks5://xray-client:1080
# HTTPS_PROXY=socks5://xray-client:1080
# ALL_PROXY=socks5://xray-client:1080
# NO_PROXY=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Proxy Checks
# ------------------------------------------------------------------------------
# Interval between proxy check cycles in seconds (default: 300)
# Note: can also be changed dynamically in Telegram via /interval <seconds> or the bot menu.
PROXY_CHECK_INTERVAL=300

# Maximum number of proxies checked concurrently per cycle (0 = unlimited, default: 0)
PROXY_CHECK_CONCURRENCY=0

# Checking method: 'ip' (requests IP service), 'status' (HTTP 204), or 'download' (tests file download)
PROXY_CHECK_METHOD=ip

# URL for IP check method (default: https://api.ipify.org?format=text)
PROXY_IP_CHECK_URL=https://api.ipify.org?format=text

# URL for status check method (default: http://cp.cloudflare.com/generate_204)
PROXY_STATUS_CHECK_URL=http://cp.cloudflare.com/generate_204

# URL for download check method (default: https://proof.ovh.net/files/1Mb.dat)
PROXY_DOWNLOAD_URL=https://proof.ovh.net/files/1Mb.dat

# Timeout for download check method in seconds (default: 60)
PROXY_DOWNLOAD_TIMEOUT=60

# Minimum bytes to download for the download check to count as successful (default: 51200)
PROXY_DOWNLOAD_MIN_SIZE=51200

# Add the measured proxy latency as an artificial delay to /config/{id} badge
# responses (for realistic uptime badges). The delay is capped at 2 seconds.
SIMULATE_LATENCY=true

# Timeout for individual proxy check in seconds (default: 30)
PROXY_TIMEOUT=30

# Resolve proxy server domains into individual IPs (default: false)
PROXY_RESOLVE_DOMAINS=false

# Starting port for local Xray SOCKS inbounds (default: 10000)
XRAY_START_PORT=10000

# Xray Core log level (debug|info|warning|error|none, default: none)
XRAY_LOG_LEVEL=none

# ------------------------------------------------------------------------------
# Web Dashboard & Metrics
# ------------------------------------------------------------------------------
# Enable web dashboard panel (default: true). Set to false to run headless/without web UI.
WEB_ENABLED=true

# Host and port for Web UI & Prometheus metrics.
# Bare metal: set METRICS_PORT=0 to disable the HTTP server entirely (Telegram bot only).
# Docker Compose: do NOT set 0 here — it breaks the ports mapping ("0:0") in
# docker-compose.yml. For a headless container set WEB_ENABLED=false and comment
# out the ports section instead.
METRICS_HOST=0.0.0.0
METRICS_PORT=2112

# Enable HTTP Basic Authentication for dashboard & metrics (recommended: true)
METRICS_PROTECTED=true
METRICS_USERNAME=admin
METRICS_PASSWORD=ChangeThisPassword123!

# Public status page inside a protected deployment (default: false).
# Requires METRICS_PROTECTED=true: the dashboard, /config/{id} pages and
# /api/v1/public/proxies become readable without a password, while /metrics
# and the admin API stay behind Basic Auth. Use only if you are fine with
# publishing proxy names/statuses.
# WEB_PUBLIC=false

# In public mode, also hide protocol badges on status cards (default: false;
# the badge is always shown in non-public mode)
# WEB_PUBLIC_SHOW_PROTOCOL=false

# Set true only when the whole dashboard sits behind an external auth proxy
# (e.g. Authelia): allows server details on the public page (default: false)
# WEB_TRUSTED_EXTERNAL_AUTH=false

# URL base path prefix for the dashboard and metrics, e.g. /xray
# (default: empty — served from root)
# METRICS_BASE_PATH=/xray

# Prometheus Pushgateway URL to push metrics instead of exposing /metrics,
# credentials in the URL are supported (https://user:pass@host:port)
# METRICS_PUSH_URL=https://pushgateway.example.com

# Custom web assets directory (logo.svg, favicon.ico, custom.css, index.html)
# WEB_CUSTOM_ASSETS_PATH=/app/data/assets

# Instance label added to Prometheus metrics (optional)
# METRICS_INSTANCE=production-checker

# Show server IP addresses and ports in Web UI (default: false)
WEB_SHOW_DETAILS=false

# ------------------------------------------------------------------------------
# General Settings
# ------------------------------------------------------------------------------
# Application log level (debug|info|warn|error|none, default: info)
LOG_LEVEL=info

# Run one check cycle and exit (for cron/scheduled jobs, default: false)
RUN_ONCE=false
